{
  "name": "@catalogcraft/api",
  "version": "0.1.0",
  "private": true,
  "description": "CatalogCraft AI REST API (Express + MongoDB).",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include ../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx src/scripts/seed.ts",
    "set-plan": "tsx src/scripts/set-plan.ts",
    "backup": "tsx src/scripts/backup.ts",
    "restore": "tsx src/scripts/restore.ts",
    "perf": "tsx tools/perf.ts",
    "e2e:server": "tsx tools/e2e-server.ts",
    "reset-password": "tsx src/scripts/reset-password.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@catalogcraft/shared": "0.1.0",
    "@node-rs/argon2": "^2.2.2",
    "connect-mongo": "^6.0.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
