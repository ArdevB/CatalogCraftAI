# CatalogCraft AI — environment configuration
# Copy this file to `.env` in the repository root and fill in real values.
# NEVER commit `.env`. Only placeholders belong in this file.
#
# The API reads these on startup and refuses to start if a value is invalid,
# printing which variable is wrong.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Port the API listens on. The Vite dev server proxies /api to this port.
PORT=4000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (MongoDB)
# ---------------------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/catalogcraft
# Atlas:  mongodb+srv://<user>:<password>@<cluster-host>/catalogcraft?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/catalogcraft

# ---------------------------------------------------------------------------
# HTTP / security
# ---------------------------------------------------------------------------
# Exact origin of the web app (used for CORS). Comma-separate multiple origins.
WEB_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the API (0 locally; usually 1 on
# hosts such as Render/Railway/Fly). Needed for correct client IPs in rate
# limiting and for secure cookies behind TLS-terminating proxies.
TRUST_PROXY_HOPS=0
# General API rate limit: max requests per IP per window.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Failed login/registration attempts allowed per IP per window.
AUTH_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------------------
# Authentication (server-side sessions)
# ---------------------------------------------------------------------------
# Signs the session cookie. At least 32 random characters; use a different
# value in every environment and keep it secret. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<generate-a-random-secret>
# Sessions end after this many hours without activity.
SESSION_TTL_HOURS=72

# ---------------------------------------------------------------------------
# Development seed data (npm run seed)
# ---------------------------------------------------------------------------
# Password for the synthetic demo account demo@catalogcraft.test.
# Leave empty to have the seed script generate one and print it.
SEED_DEMO_PASSWORD=

# ---------------------------------------------------------------------------
# Web app
# ---------------------------------------------------------------------------
# The web app does NOT read this file (it would turn production builds into
# development builds). Browser settings go in apps/web/.env or your hosting
# platform, e.g. VITE_API_BASE_URL=https://api.example.com/api/v1 — only needed
# when the API is on a different domain. Never put secrets in VITE_ variables.

# ---------------------------------------------------------------------------
# File imports
# ---------------------------------------------------------------------------
# Private storage for uploaded files (relative to the repository root, or an
# absolute path). Never served directly; downloads always go through the API.
STORAGE_LOCAL_DIR=./storage
# Maximum upload size in megabytes, and maximum product rows per job.
UPLOAD_MAX_MB=10
IMPORT_MAX_ROWS=2000

# ---------------------------------------------------------------------------
# AI enrichment (Anthropic Claude)
# ---------------------------------------------------------------------------
# Optional. Without a key the app runs normally and AI features say they are
# not configured — they never return fake results. Create a key at
# https://console.anthropic.com and keep it secret (server-side only).
AI_API_KEY=
# Model used for suggestions. Default: claude-opus-5-5 ($4 / $20 per million
# input/output tokens). claude-haiku-5-5 costs about 40x less ($0.10 / $0.50);
# claude-sonnet-5-5 sits in between ($2 / $10). Your choice — compare quality
# on a small job first.
AI_MODEL=claude-opus-5-5
# How much the model reasons before writing: low | medium | high. Short
# product copy rarely benefits from more than low; higher costs more tokens.
AI_EFFORT=low
# Upper bound on tokens per product response (also caps cost per product).
AI_MAX_OUTPUT_TOKENS=4000
# Per-request timeout and automatic retries for rate limits / overloads.
AI_TIMEOUT_MS=90000
AI_MAX_RETRIES=2
# Products processed at the same time by the background worker.
AI_CONCURRENCY=3

# ---------------------------------------------------------------------------
# Planned for later milestones (not read by the code yet)
# ---------------------------------------------------------------------------
# Background jobs (Phase 3, only if a queue is introduced):
# REDIS_URL=redis://127.0.0.1:6379
